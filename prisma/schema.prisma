// Prisma schema for SMLAO Tax Invoice System

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum TodoStage {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  name        String
  role        UserRole  @default(STAFF)
  locale      String    @default("lo")  // lo | th | en — controls UI language
  theme       String    @default("light") // light | dark — Odoo theme variant
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastSeenAt  DateTime?
  invoices  Invoice[]
  payments  Payment[]
  messages  Message[]
  activitiesAssigned Activity[] @relation("AssignedTo")
  activitiesCreated  Activity[] @relation("CreatedBy")
  follows   Follower[]
  quotationsCreated Quotation[] @relation("QuotationCreator")
  emailsSent        EmailLog[]  @relation("EmailSender")
  activityLog       UserActivity[] @relation("UserActivities")
  todosAssigned     TodoTask[] @relation("TodoAssignedTo")
  todosCreated      TodoTask[] @relation("TodoCreatedBy")
}

enum MessageKind {
  COMMENT  // public message (email-like)
  NOTE     // internal note
  LOG      // system audit log
}

model Message {
  id         String      @id @default(cuid())
  body       String
  kind       MessageKind @default(COMMENT)
  recordType String      // "invoice" | "product" | "customer"
  recordId   String
  authorId   String
  author     User        @relation(fields: [authorId], references: [id])
  createdAt  DateTime    @default(now())

  @@index([recordType, recordId, createdAt])
}

model Activity {
  id           String    @id @default(cuid())
  summary      String
  note         String?
  dueDate      DateTime
  done         Boolean   @default(false)
  doneAt       DateTime?
  recordType   String
  recordId     String
  assignedToId String
  assignedTo   User      @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User      @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([recordType, recordId])
  @@index([assignedToId, done])
}

model Follower {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  recordType String
  recordId   String
  createdAt  DateTime @default(now())

  @@unique([userId, recordType, recordId])
  @@index([recordType, recordId])
}

model TodoTask {
  id           String    @id @default(cuid())
  title        String
  description  String?
  stage        TodoStage @default(TODO)
  priority     Int       @default(0) // 0 normal, 1 high, 2 urgent
  dueDate      DateTime?
  doneAt       DateTime?
  assignedToId String?
  assignedTo   User?     @relation("TodoAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User      @relation("TodoCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([stage, dueDate])
  @@index([assignedToId, stage])
  @@index([createdById])
}

model Product {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String?
  imageUrl      String?
  unit          String   @default("ອັນ")
  unitId        String?
  uom           Unit?    @relation(fields: [unitId], references: [id])
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  typeId        String?
  type          ProductType? @relation(fields: [typeId], references: [id])
  warehouseId   String?
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])
  costingMethod String   @default("STANDARD") // STANDARD | AVERAGE | FIFO
  priceLak      Float
  costLak       Float    @default(0)
  stock         Float    @default(0)
  minStock      Float    @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  invoiceItems   InvoiceItem[]
  stockMovements StockMovement[]
  recurringItems RecurringInvoiceItem[]
  quotationItems QuotationItem[]

  @@index([categoryId])
  @@index([typeId])
  @@index([warehouseId])
}

model Unit {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products  Product[]
}

model Category {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    Product[]
}

model ProductType {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  trackStock Boolean  @default(true)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  products   Product[]
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products  Product[]
}

model Customer {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  imageUrl   String?
  taxId      String?
  phone      String?
  email      String?
  address    String?
  provinceId String?
  province   Province? @relation(fields: [provinceId], references: [id])
  districtId String?
  district   District? @relation(fields: [districtId], references: [id])
  villageId  String?
  village    Village?  @relation(fields: [villageId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  invoices   Invoice[]
  recurringInvoices RecurringInvoice[]
  quotations Quotation[]

  @@index([provinceId])
  @@index([districtId])
  @@index([villageId])
}

model Province {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  nameEn    String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  districts District[]
  customers Customer[]
}

model District {
  id         String     @id @default(cuid())
  code       String     @unique
  name       String
  nameEn     String?
  provinceId String
  province   Province   @relation(fields: [provinceId], references: [id])
  villages   Village[]
  customers  Customer[]
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([provinceId])
}

model Village {
  id         String     @id @default(cuid())
  code       String?
  name       String
  nameEn     String?
  districtId String
  district   District   @relation(fields: [districtId], references: [id])
  customers  Customer[]
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([districtId])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  date          DateTime      @default(now())
  dueDate       DateTime?
  customerId    String
  userId        String
  currency      String        @default("LAK")
  exchangeRate  Float         @default(1)
  subtotal      Float
  discount      Float         @default(0)
  vatRate       Float         @default(0.1)
  vatMode       String        @default("EXCLUSIVE") // EXCLUSIVE | INCLUSIVE | EXEMPT
  vatAmount     Float
  total         Float
  paymentMethod String        @default("CASH") // CASH | TRANSFER
  paymentRef    String?       // transfer reference / slip no.
  paidAmount    Float         @default(0)
  paymentStatus PaymentStatus @default(UNPAID)
  status        InvoiceStatus @default(ISSUED)
  note          String?
  paymentTermId String?
  paymentTerm   PaymentTerm?  @relation(fields: [paymentTermId], references: [id])
  isCreditNote  Boolean       @default(false)
  reversedId    String?       // original invoice if this is a credit note
  reversed      Invoice?      @relation("InvoiceReversal", fields: [reversedId], references: [id])
  reversals     Invoice[]     @relation("InvoiceReversal")
  // eTax Invoice Gateway integration
  etaxSerialNum     String?   // our unique 32-char idempotency key sent to gateway
  etaxInvoiceNumber String?   // 20-digit tax authority invoice ID
  etaxIssueTime     String?   // yyyy-MM-dd HH:mm:ss from tax server
  etaxCheckCode     String?   // 16-char check code
  etaxQrUrl         String?   // QR url for invoice delivery
  etaxStatus        String?   // 0=Issued, 1=Approved, 3=Invalid, 6=Cancelled
  etaxStatusReason  String?   // human-readable reason when status=3
  etaxSubmittedAt   DateTime?
  etaxLastCheckedAt DateTime?
  etaxErrorCode     String?
  etaxErrorMsg      String?
  recurringId   String?                     // set when this invoice was auto-generated
  recurring     RecurringInvoice? @relation("RecurringInvoiceGenerated", fields: [recurringId], references: [id], onDelete: SetNull)
  quotations    Quotation[]   @relation("QuotationInvoice")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customer      Customer      @relation(fields: [customerId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  items         InvoiceItem[]
  payments      Payment[]

  @@index([date])
  @@index([customerId])
  @@index([paymentStatus])
  @@index([recurringId])
}

model PaymentTerm {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  days      Int      @default(0) // 0 = immediate, 30 = Net 30
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invoices  Invoice[]
}

model Payment {
  id        String   @id @default(cuid())
  number    String   @unique
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  method    String   @default("CASH") // CASH | BANK | TRANSFER | OTHER
  date      DateTime @default(now())
  reference String?
  note      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
}

model InvoiceItem {
  id         String  @id @default(cuid())
  invoiceId  String
  lineType   String  @default("PRODUCT") // PRODUCT | SECTION | NOTE
  productId  String?
  productName String
  unit       String
  quantity   Float
  priceLak   Float
  discount   Float   @default(0)
  taxRate    Float   @default(0.1)
  taxAmount  Float   @default(0)
  total      Float
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

enum RecurringCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

// Append-only log of outbound emails — visible to admin for troubleshooting
// "did the reminder actually go?" The body is not stored to keep rows small.
model EmailLog {
  id          String   @id @default(cuid())
  toEmail     String
  subject     String
  kind        String                          // invoice / reminder / quotation / statement / other
  recordType  String?                         // "Invoice" / "Quotation" / ...
  recordId    String?
  status      String   @default("SENT")      // SENT | FAILED
  errorMsg    String?
  sentByUserId String?
  sentBy      User?    @relation("EmailSender", fields: [sentByUserId], references: [id])
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([recordType, recordId])
}

// Single feed for all in-app user activity: login/logout, CRUD on records,
// admin actions (role/password change, user delete). Used by /users/[id]/activity
// (per-user timeline) and /activity (global feed, admin-only).
model UserActivity {
  id         String   @id @default(cuid())
  userId     String?  // nullable — failed logins have no user
  user       User?    @relation("UserActivities", fields: [userId], references: [id], onDelete: SetNull)
  action     String   // LOGIN | LOGIN_FAIL | LOGOUT | CREATE | UPDATE | DELETE | ROLE_CHANGE | PASSWORD_CHANGE | ISSUE | CANCEL
  recordType String?  // "Invoice" | "Customer" | "Product" | "User" | "Quotation" | ...
  recordId   String?
  summary    String   // human-readable Lao: "ສ້າງບິນ INV/0001"
  meta       String?  // optional JSON: { ip, before, after, targetUserId, ... }
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([recordType, recordId])
  @@index([action])
}

enum QuotationStatus {
  DRAFT       // ຮ່າງ — editable
  SENT        // ສົ່ງໃຫ້ລູກຄ້າແລ້ວ
  ACCEPTED    // ລູກຄ້າຍອມຮັບ
  REJECTED    // ປະຕິເສດ
  EXPIRED     // ໝົດອາຍຸ (auto when validUntil < now)
  CONVERTED   // ກາຍເປັນບິນແລ້ວ
}

// Sales proposal sent to a (potential) customer before billing. Once accepted,
// "Convert to invoice" turns it into a real Invoice and marks it CONVERTED.
model Quotation {
  id            String           @id @default(cuid())
  number        String           @unique         // QT-YYYYMM-####
  date          DateTime         @default(now())
  validUntil    DateTime?
  customerId    String
  customer      Customer         @relation(fields: [customerId], references: [id])
  userId        String
  user          User             @relation("QuotationCreator", fields: [userId], references: [id])
  reference     String?                            // customer's PO / opportunity ref
  currency      String           @default("LAK")
  exchangeRate  Float            @default(1)
  subtotal      Float
  discount      Float            @default(0)
  vatRate       Float            @default(0.1)
  vatMode       String           @default("EXCLUSIVE")
  vatAmount     Float
  total         Float
  status        QuotationStatus  @default(DRAFT)
  note          String?
  // Tracking when the quote was sent / decided
  sentAt        DateTime?
  decidedAt     DateTime?
  // Once converted, points at the resulting Invoice
  invoiceId     String?
  invoice       Invoice?         @relation("QuotationInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  items         QuotationItem[]

  @@index([date])
  @@index([customerId])
  @@index([status])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  lineType    String    @default("PRODUCT") // PRODUCT | SECTION | NOTE
  productId   String?
  productName String
  unit        String
  quantity    Float
  priceLak    Float
  discount    Float     @default(0)
  taxRate     Float     @default(0.1)
  taxAmount   Float     @default(0)
  total       Float
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quotationId])
}

// Template that auto-generates Invoices on a recurring schedule. Operator
// edits the template (customer, items, cycle, nextRunDate); the cron-driven
// generator clones it into a new Invoice each cycle.
model RecurringInvoice {
  id            String                 @id @default(cuid())
  code          String                 @unique           // RC-0001
  name          String                                    // friendly title shown in list
  customerId    String
  customer      Customer               @relation(fields: [customerId], references: [id])
  active        Boolean                @default(true)
  cycle         RecurringCycle         @default(MONTHLY)
  startDate     DateTime               @default(now())
  nextRunDate   DateTime                                  // when to generate the next invoice
  endDate       DateTime?                                 // stop generating after this
  // Invoice defaults
  currency      String                 @default("LAK")
  exchangeRate  Float                  @default(1)
  vatMode       String                 @default("EXCLUSIVE")
  vatRate       Float                  @default(0.1)
  discount      Float                  @default(0)
  paymentMethod String                 @default("CASH")
  note          String?
  // Stats
  lastRunAt     DateTime?
  generatedCount Int                   @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  items         RecurringInvoiceItem[]
  invoices      Invoice[]              @relation("RecurringInvoiceGenerated")

  @@index([active, nextRunDate])
  @@index([customerId])
}

model RecurringInvoiceItem {
  id           String           @id @default(cuid())
  recurringId  String
  recurring    RecurringInvoice @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  lineType     String           @default("PRODUCT") // PRODUCT | SECTION | NOTE
  productId    String?
  productName  String
  unit         String
  quantity     Float
  priceLak     Float
  discount     Float            @default(0)
  taxRate      Float            @default(0.1)
  taxAmount    Float            @default(0)
  product      Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([recurringId])
}

enum StockMovementType {
  IN
  OUT
  ADJUST
}

model StockMovement {
  id        String            @id @default(cuid())
  productId String
  type      StockMovementType
  quantity  Float
  reference String?
  note      String?
  createdAt DateTime          @default(now())
  product   Product           @relation(fields: [productId], references: [id])

  @@index([productId])
}

model Setting {
  id              String   @id @default("default")
  shopName        String   @default("ຮ້ານຄ້າ")
  shopNameEn      String?
  taxId           String?
  address         String?
  phone           String?
  email           String?
  logoUrl         String?
  // SMTP config for sending invoices/reminders by email (optional)
  smtpHost        String?
  smtpPort        Int?     @default(587)
  smtpUser        String?
  smtpPassword    String?  // stored at rest; encrypt at app layer in production
  smtpFromName    String?
  smtpFromEmail   String?
  smtpSecure      Boolean  @default(false) // true = use TLS (port 465)
  // Bank account printed on invoice PDF (optional)
  bankName        String?  // e.g. "BCEL LAK"
  bankAccount     String?  // e.g. "220-11-00036139"
  bankAccountName String?  // account holder, typically same as shopName
  // Business license printed at invoice footer (optional)
  licenseNumber   String?  // e.g. "201/ສອ.ມຊຖ"
  licenseDate     String?  // free-text date e.g. "19-02-2025"
  vatRate         Float    @default(0.1)
  defaultCurrency String   @default("LAK")
  invoicePrefix   String   @default("INV")
  // Feature toggles
  enablePos          Boolean @default(false)
  enableCreditNotes  Boolean @default(true)
  enableChatter      Boolean @default(true)
  enableReports      Boolean @default(true)
  enableDashboard    Boolean @default(true)
  enableTodo         Boolean @default(true)
  // eTax behaviour — credentials are now global (master DB EtaxConfig).
  // Per-tenant only controls whether to auto-submit invoices to the gateway.
  etaxAutoSubmit     Boolean @default(false)
  updatedAt       DateTime @updatedAt
}
