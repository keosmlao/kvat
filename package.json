{
  "name": "smlao-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_EXTRA_CA_CERTS=./certs/etax-ca.pem next dev",
    "build": "NODE_EXTRA_CA_CERTS=./certs/etax-ca.pem next build",
    "start": "NODE_EXTRA_CA_CERTS=./certs/etax-ca.pem next start",
    "lint": "eslint",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "master:generate": "prisma generate --config prisma.master.config.ts",
    "master:migrate": "prisma migrate dev --config prisma.master.config.ts",
    "master:migrate:deploy": "prisma migrate deploy --config prisma.master.config.ts",
    "master:seed": "tsx prisma/master/seed.ts",
    "master:seed:template": "tsx prisma/master/seed-template.ts",
    "dump:tenant-schema": "bash scripts/dump-tenant-schema.sh",
    "trial:expire": "tsx scripts/trial-expire.ts",
    "loginlog:prune": "tsx scripts/loginlog-prune.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-pdf/renderer": "^4.5.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "date-fns": "^4.1.0",
    "jose": "^6.2.3",
    "next": "16.2.6",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
